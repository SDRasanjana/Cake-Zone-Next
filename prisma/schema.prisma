// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid()) @map("_id")
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
 
model User {
  id                  String    @id @default(cuid()) @map("_id")
  name                String?
  email               String?   @unique
  emailVerified       DateTime? @map("email_verified")
  image               String?
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  notifications       Notification[]
  role                UserRole? @relation(fields: [roleId], references: [id])
  roleId              String?   @unique
  cakeConfigurations  CakeConfiguration[] // Added for opposite relation

  @@map("users")
}
 
model VerificationToken {
  identifier String   @id @map("_id") // Changed to be the id
  token      String   @unique
  expires    DateTime
 
  @@unique([identifier, token]) // Keep this if identifier alone isn't globally unique, or remove if identifier is the sole PK
  @@map("verification_tokens")
}

model Order {
  id                  String      @id @default(cuid()) @map("_id")
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  status              String      // PENDING, PROCESSING, COMPLETED, CANCELLED
  totalAmount         Float
  deliveryDate        DateTime
  shippingAddress     String
  stripePaymentIntentId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                        String   @id @default(cuid()) @map("_id")
  orderId                   String
  order                     Order    @relation(fields: [orderId], references: [id])
  cakeName                  String
  cakeConfigurationDetails  Json     // Storing customized cake details
  quantity                  Int
  price                     Float
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("order_items")
}

model CakeConfiguration {
  id                String    @id @default(cuid()) @map("_id")
  name              String
  description       String?
  basePrice         Float
  availableLayers   Int[]
  availableFlavors  String[]
  availableToppings String[]
  availableColors   String[]
  imageUrl          String?
  isPredefined      Boolean   @default(false)
  createdByUserId   String?   // Optional: if users can save designs
  createdByUser     User?     @relation(fields: [createdByUserId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("cake_configurations")
}

model UserRole {
  id          String  @id @default(cuid()) @map("_id")
  name        String  @unique // CUSTOMER, OWNER, ADMIN
  description String?
  users       User[] // This implies a User can have multiple roles if you change User.role to UserRole[]

  @@map("user_roles")
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  type      String   // ORDER_UPDATE, PROMOTION, SYSTEM_ALERT
  read      Boolean  @default(false)
  link      String?  // e.g., to an order page
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model IngredientPriceHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ingredientName String
  price          Float
  date           DateTime
  supplier       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ingredientName, date])
  @@map("ingredient_price_histories") // Explicitly mapping collection name
}
